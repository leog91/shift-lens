{
  "name": "shift-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SHIFT_LENS_DATA_MODE=local bun run scripts/dev.ts",
    "demo": "SHIFT_LENS_DATA_MODE=demo next dev --webpack",
    "dev:web": "next dev --webpack --hostname 127.0.0.1",
    "dev:ocr": "cd ocr-service && .venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8001",
    "profile:init": "bun run scripts/init-profile.ts",
    "hosted:init": "bun run scripts/init-hosted.ts",
    "hosted:owner": "bun run scripts/provision-hosted-owner.ts",
    "hosted:dev": "SHIFT_LENS_DATA_MODE=hosted next dev --webpack",
    "start": "next start",
    "start:local": "SHIFT_LENS_DATA_MODE=local next start --hostname 127.0.0.1",
    "test": "bun run test:unit && cd ocr-service && .venv/bin/python -m pytest",
    "test:unit": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "next build --webpack"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.22",
    "@libsql/client": "0.18.0",
    "better-auth": "1.7.22",
    "better-sqlite3": "13.1.1",
    "drizzle-orm": "0.45.4",
    "fast-fuzzy": "1.12.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
