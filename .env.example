# LOCAL COMPUTER ONLY: add these to .env.local after configuring the hosted app.
# Leave SYNC_URL empty to keep everything local. Never use NEXT_PUBLIC_ secrets.
SHIFT_LENS_DATA_MODE=local
# Default: use the existing data/ and photo-inbox/ folders in the project root.
# Set this only if your existing database and photos live in a separate profile:
# SHIFT_LENS_PROFILE_DIR=profiles/restaurant-a
SHIFT_LENS_SYNC_URL=
SHIFT_LENS_SYNC_TOKEN=
SHIFT_LENS_SYNC_SOURCE_ID=

# HOSTED: configure these in Vercel Production and an ignored .env.hosted.local
# for local admin commands. Do not copy them into the local app's .env.local.
# SHIFT_LENS_DATA_MODE=hosted
# TURSO_DATABASE_URL=libsql://your-private-database.turso.io
# TURSO_AUTH_TOKEN=
# BETTER_AUTH_URL=https://your-dashboard.example.com
# BETTER_AUTH_SECRET=
# SHIFT_LENS_HOSTED_COMPANY_ID=your-business-id
# SHIFT_LENS_HOSTED_OWNER_EMAIL=you@example.com
# Create the owner interactively; do not store its password here:
# bun --env-file=.env.hosted.local run hosted:init
# bun --env-file=.env.hosted.local run hosted:owner
# SHIFT_LENS_SYNC_TOKEN=the-same-sync-token-as-the-local-computer
# SHIFT_LENS_SYNC_SOURCE_ID=the-same-source-uuid-as-the-local-computer
# Do NOT set SHIFT_LENS_PROFILE_DIR, SYNC_URL, OCR, or OpenAI variables on the host.
